# SETTLE — .gitignore
# All directory patterns are anchored with leading / to prevent source-leak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment (anchored to root)
/venv/
/env/
/ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# Node (opencode runtime)
/node_modules/

# Windows artifacts
nul

# One-off scripts (root only)
/test_db_conn.py
/recover_pyc.py

# Environment variables
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
/logs/

# Data (anchored to root — bulk scraping artifacts: FJC dumps, CSV outputs)
/data/

# SETTLE data scraping factory — runtime artifacts (network cache + scraped outputs)
settle_data_scraping_factory/_cache/
settle_data_scraping_factory/**/out/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
/htmlcov

# Temporary files
*.tmp
*.temp
